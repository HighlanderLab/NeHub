nextflow.enable.dsl=2
nextflow.enable.configProcessNamesValidation = false
includeConfig 'conf/params.config'
includeConfig 'conf/resources.config'  

// ─── Reporting ────────────────────────────────────────────────────────────────
timeline { enabled = true; overwrite = true; file = "./logs/timeline.html" }
trace    { enabled = true; overwrite = true; file = "./logs/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "./logs/dag.png"       }

env { MALLOC_ARENA_MAX = 1 }

conda      { enabled = false }
singularity { enabled = false }   // enabled selectively inside the eddie profile

// ─────────────────────────────────────────────────────────────────────────────
// Profiles
// Usage: nextflow run main.nf -profile <name>[,<name>...]
//
// Execution profiles (choose one):
//   eddie    – SGE cluster on Edinburgh Eddie (default for cluster runs)
//   docker   – run every process in the NeHub Docker image
//   github   – GitHub Actions CI: conda envs activated per label (no Docker) 
//   local    – local executor, for quick ad-hoc runs
//
// Resource profiles (combinable with any execution profile):
//   small    – reduced cpus/memory for testing or small datasets
//   large    – increased cpus/memory for big datasets (>100 samples)
//
// Examples:
//   nextflow run main.nf -profile eddie
//   nextflow run main.nf -profile eddie,large
//   nextflow run main.nf -profile docker,small
//   nextflow run main.nf -profile github,small
// ─────────────────────────────────────────────────────────────────────────────
profiles {
    sge_singularity {
    singularity {
        enabled    = true
        runOptions = "-B \$PWD -B ${projectDir} -B ${projectDir}/scripts"
        autoMounts = true
    }
    executor {
        name      = 'sge'
        queueSize = 8
    }
    process {
        container     = "/exports/eddie/scratch/${System.getenv('USER')}/nehub.sif"
        stageInMode   = 'symlink'
        scratch       = 'false'
        errorStrategy = 'ignore'
        clusterOptions = '-V -cwd'
    }
}
    // ── local ─────────────────────────────────────────────────────────────────
    // Local machine, for quick ad-hoc runs without SGE.
    local_singularity {
        singularity {
            enabled      = true
            runOptions = "--nv -B \$PWD -B ${projectDir} -B ${projectDir}/scripts" 
            autoMounts   = true
        }
        executor {
            name      = 'local'
            queueSize = 8
        }
        process {
            container = "/exports/eddie/scratch/${System.getenv('USER')}/nehub.sif"
            stageInMode   = 'symlink'
            scratch       = 'false'
            maxForks      = 9
            errorStrategy = 'ignore'
            // After testing, it was found that chromosomes with a size of 80 Mb can run smoothly using Singularity,
            // and this approach is even more stable than using Conda.
            withName: 'run_smcpp_process' { container   = null; beforeScript = """
                . /etc/profile.d/modules.sh
                module load singularity
                export SINGULARITY_TMPDIR="/exports/eddie/scratch/${System.getenv('USER')}/tmp"
                mkdir -p "\$SINGULARITY_TMPDIR"
                export SMCPP="singularity run -B \$PWD docker://terhorst/smcpp:latest"
                """}
        }
    }
     // ── docker ────────────────────────────────────────────────────────────────
    // Every process runs inside the NeHub image.
    // Build first:  docker build -t NeHub:latest -f docker/Dockerfile .
    docker {
        docker.enabled      = true
        singularity.enabled = false
        conda.enabled       = false
        executor {
            name      = 'local'
            queueSize = 8
        }
        process {
            // add your local container or public container
            container = "./nehub.sif" 
            runOptions = "-v ${projectDir}:${projectDir}"
            stageInMode   = 'symlink'
            scratch       = 'false'
            maxForks      = 9
            errorStrategy = 'ignore'
        }
    }
    // ── local ─────────────────────────────────────────────────────────────────
    // Local machine, for quick ad-hoc runs without SGE.
    local_no_Nehub_docker {
        executor {
            name      = 'local'
            queueSize = 8
        }
        process {
            stageInMode   = 'symlink'
            scratch       = 'false'
            maxForks      = 9
            errorStrategy = 'ignore'
            withLabel: 'basic_Ne'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate basic_Ne';    clusterOptions = '' }
            withLabel: 'ts_tools'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate ts_tools';    clusterOptions = '' }
            withLabel: 'bcftools'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate bcftools';    clusterOptions = '' }
            withLabel: 'smcpp'                { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate smcpp';    clusterOptions = ''}            
            withLabel: 'plink'                { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate basic_Ne';    clusterOptions = '' }
            withLabel: 'ne_pipe_phlash' { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate phlash'; clusterOptions = '' }
        }
    }

    // ── sge with singularity  ─────────────────────────────────────────────────────────────────
    // SGE cluster on Edinburgh Eddie. Uses conda envs and singularity for smc++.
    // Make sure every conda envs and software have been installed
    sge_no_singularity {
        singularity {
            enabled      = true
            envWhitelist = "SINGULARITY_TMPDIR,TMPDIR"
            runOptions   = '-p -B "$TMPDIR"'
            autoMounts   = true
        }

        executor {
            name            = 'sge'
            queueSize       = 20
            submitRateLimit = '10 sec'
        }

        process {
            maxForks      = 9
            stageInMode   = 'symlink'
            scratch       = 'false'
            penv          = { task.cpus > 1 ? "sharedmem" : null }
            errorStrategy = 'retry'
            maxRetries    = 3

            // Add 4 GB overhead per job so SGE reserves enough for the JVM,
            // singularity unpacking, and other system processes.
            clusterOptions = {
                def extraMemory  = (task.memory ? task.memory.toMega() : 0) + 4096
                def memoryPerCpu = extraMemory / task.cpus
                System.getenv('NFX_SGE_PROJECT') ?
                    "-l h_vmem=${memoryPerCpu}M -P ${System.getenv('NFX_SGE_PROJECT')}" :
                    "-l h_vmem=${memoryPerCpu}M -P uoe_baseline"
            }

            withLabel: 'basic_Ne' {
                beforeScript = """
                source /exports/applications/apps/RL9/anaconda/2024.02/etc/profile.d/conda.sh
                conda activate basic_Ne
                """
            }
            withLabel: 'ts_tools' {
                beforeScript = """
                source /exports/applications/apps/RL9/anaconda/2024.02/etc/profile.d/conda.sh
                conda activate ts_tools
                """
            }
            withLabel: 'bcftools' {
                beforeScript = """
                source /exports/applications/apps/RL9/anaconda/2024.02/etc/profile.d/conda.sh
                conda activate bcftools
                """
            }
            withLabel: 'smcpp' {
                beforeScript = """
                source /exports/applications/apps/RL9/anaconda/2024.02/etc/profile.d/conda.sh
                conda activate smcpp
                """
            }
            withLabel: 'plink' {
                beforeScript = """
                . /etc/profile.d/modules.sh
                module load roslin/plink/2.0-dev
                """
            }
            withLabel: 'ne_pipe_phlash' {
                clusterOptions = '-q gpu -l gpu=1 -l h_rt=12:00:00'
                beforeScript = """
                source /exports/applications/apps/RL9/anaconda/2024.02/etc/profile.d/conda.sh
                conda activate phlash
                """
            }
        }
    }
    // ── github ────────────────────────────────────────────────────────────────
    // GitHub Actions CI: conda envs installed directly on the runner (no Docker).
    // Envs are created from conf/envs/*.yml + pip installs in ci.yml.
    github {
        docker.enabled    = false
        singularity.enabled = false
        conda.enabled       = false
        executor.name       = 'local'

        process {
            withLabel: 'basic_Ne'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate basic_Ne';    clusterOptions = '' }
            withLabel: 'ts_tools'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate ts_tools';    clusterOptions = '' }
            withLabel: 'bcftools'             { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate bcftools';    clusterOptions = '' }
            withLabel: 'smcpp'                { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate smcpp' }
            withLabel: 'plink'                { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate basic_Ne';    clusterOptions = '' }
            withLabel: 'ne_pipe_phlash' { beforeScript = 'source $(conda info --base)/etc/profile.d/conda.sh && conda activate phlash'; clusterOptions = '' }
        }

        includeConfig 'conf/test.config'
    }
}