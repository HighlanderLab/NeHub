// CI test configuration — used by the 'ci' profile in nextflow.config.
//
// Scientific / non-path parameters for all 8 methods are defined here.
// External tool installation paths (GONE, Relate, Stairway, easySFS) are
// injected by the GitHub Actions workflow via '-params-file' so that they
// point to the tools downloaded during CI setup.
//
// Run locally after downloading tools:
//   nextflow run main.nf -profile docker,small \
//       --method 'GONE,SMCpp,stairway,tskit,PSMC,Relate,Phlash,MSMC' \
//       -params-file tests/ci_params.json

params {
    input_dir       = "${projectDir}/tests/test_data"
    output_dir      = "${projectDir}/tests/output"
    chromosomes     = [1]
    population_file = "popLabel.txt"
    mutation_rate   = 1e-8
    sampling        = 1
    seed       = 100

    // Shared ref/ancestral genome (both = the synthetic FASTA from test data)
    option = [
        ref_genome      : "${projectDir}/tests/test_data/test.fa",
        ancestral_genome: "${projectDir}/tests/test_data/test.fa"
    ]

    PSMC = [
        ref_genome         : params.option.ref_genome,
        timeSegmentPattern : "4+8*1+4+6",   // shorter pattern for speed
        bin_size           : 100
    ]

    MSMC = [
        sampleSize         : 2,             // 2 individuals (max for quick test)
        timeSegmentPattern : "1*2+4*1+1*2",
        rhoOverMu          : 0.22,
        maxIterative       : 2
    ]

    tskit = [
        ancestral_genome: params.option.ancestral_genome,
        timepoint       : 8,
        max_file_size   : 100 * 1024 * 1024,
        chunk_size      : 1024
    ]

    stairway = [
        // easysfs_path and stairway_path are injected via -params-file in CI
        ancestral_genome    : params.option.ancestral_genome,
        fold                : 0,
        ploids              : 2,
        generation_interval : 1,
        pct_training        : 0.67,
        nrand               : "2\t3\t4",
        ninput              : 2,
        xrange              : "0.1,10000",
        yrange              : "0,0",
        xspacing            : 2,
        yspacing            : 2,
        fontsize            : 12
    ]

    Relate = [
        // Relate_path and genMap_dir injected via -params-file in CI
        ancestral_genome: params.option.ancestral_genome,
        initial_N       : 10000,
        threshold       : 0.5,
        num_iter        : 1,        // 1 iteration for CI speed
        num_chunk       : 2,
        bins            : "2,4,0.3",
        seed            : 42,
        years_per_gen   : 1
    ]

    GONE = [
        // installation_path injected via -params-file in CI
        PHASE    : 2,
        cMMb     : 1,
        DIST     : 1,
        NGEN     : 200,
        NBIN     : 40,
        MAF      : 0.0,
        ZERO     : 1,
        maxNCHROM: -99,
        maxNSNP  : 5000,
        hc       : 0.05,
        REPS     : 2,
        threads  : 2
    ]

    Phlash = [
        chr_test: 0
    ]
}
