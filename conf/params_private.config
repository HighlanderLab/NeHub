// This file is used to set the parameters for the pipeline  
params {

    // Map YAML values to Nextflow params
    input_dir         = "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/data_simulation/test/test0_vcf"
    method            = ['GONE,SMCpp,stairway,PSMC,Relate,tskit'] //'GONE,SMCpp,stairway,PSMC,MSMC,Phlash,Relate,tskit'
    chromosomes      = [1,2] // the file name should be like 'xxx.chr1.vcf.gz' 1..18
    mutation_rate     = 4.8e-9
    population_file   = 'test0.popLabel'
    output_dir        = "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/Ne_simulation/nf/test0_vcf"
    // Sampling
    sampling = 1 // Sampling rate (0.0-1.0), default=1.0 (no sampling)
    seed = 100 // base seed
    // ***stairway ninput and GONE REP test need to fix if pursue accuracy**
    option = [
          // Reference genome (if required by the method)
          ref_genome:  "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/data_simulation/test/test0.fa",
          // Ancestral genome (if required by the method)
          ancestral_genome:  "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/data_simulation/test/test0.fa"
    ]
    PSMC = [  
      ref_genome: params.option.ref_genome,
      timeSegmentPattern: "4+50*1+4+6",
      bin_size: 100
    ]
    MSMC = [
      sampleSize: 4,
      timeSegmentPattern: "1*2+25*1+1*2+1*3",
      rhoOverMu: 0.22,
      maxIterative: 4
    ]
    tskit = [
      ancestral_genome: params.option.ancestral_genome,
      timepoint: 64, // file numpy of timepoint for Ne, if no path to the time point, the pipeline will use this value as the number of time points for quartiles of the time range
      max_file_size: 4*500*1024*1024, //max_file_size of Zarr
      chunk_size: 2*1024 //chunk_size of Zarr
    ]

    stairway = [
      easysfs_path: "/home/s2587593/PigData/git_soft/easySFS/easySFS.py",
      stairway_path: "/home/s2587593/PigData/git_soft/stairway_plot_v2.1.2/stairway_plot_es",
      ancestral_genome: params.option.ancestral_genome,
      fold: 0, // if 1 , fold; other is unfold
      ploids: 2,
      generation_interval: 5, // assumed generation time (in years), summary results use 'generation' as units, so this value didn't affect final results, but if you are insterested the plot, it must be setting
      pct_training: 0.67 , // percentage of sites for training 
      nrand: "7	15	22	28" , // number of random break points for each try (separated by white space)
      ninput: 40 , // number of input files to be created for each estimation
      // plot settings, if don't want to plot, just keep the default value
      xrange:'0.1,10000' , // # Time (1k year) range; format: xmin,xmax; "0,0" for default
      yrange: "0,0", // Ne (1k individual) range; format: xmin,xmax; "0,0" for default
      xspacing: 2, // X axis spacing
      yspacing: 2, // Y axis spacing
      fontsize: 12, // Font size
    ]
    Relate = [
      ancestral_genome: params.option.ancestral_genome,
      Relate_path: "/home/s2587593/PigData/git_soft/relate_v1.2.2_x86_64_dynamic",
      genMap_dir: "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/data_simulation/test/test0_vcf/",
      initial_N: 20000,
      threshold: 0.5, //Float in [0,1] which is the fraction of trees to be dropped, ranked by number of mutations mapping. This option serves two purposes: First, it removes bad/uninformative trees. Second it speeds up the inference. As we increase this value, we remove more trees. Default: 0.5.
      num_iter: 5, //Number of iterations of the algorithm. Default is 5.
      num_chunk: 10, //Controls how the dataset is split into chunks for parallel processing.
      bins: "2,7,0.3", //Specify epoch bins. Format: lower, upper, stepsize for function c(0,10^seq(lower, upper, stepsize)).
      seed: 100, //Sets the random seed for stochastic parts of the algorithm (e.g., sampling coalescent trees).
      years_per_gen: 5, //Years per generation. Default: 28.0
    ]
    // NGEN 2000,NBIN:400,REPS: 40
    GONE = [
      installation_path: "/home/s2587593/PigData/git_soft/GONE/",
      PHASE: 2, //Phase = 0 (pseudohaploids), 1 (known phase), 2 (unknown phase)
      cMMb:  1, //CentiMorgans per Megabase (if distance is not available in map file).
      DIST: 1, //none (0), Haldane correction (1) or Kosambi correction (2)
      NGEN: 2000, //Number of generations for which linkage data is obtained in bins
      NBIN: 400, // Number of bins (e.g. if 400, each bin includes NGEN/NBIN = 2000/400 = 5 generations)
      MAF: 0.0, //Minor allele frequency (0-1) (recommended 0)
      ZERO: 1, //0: Remove SNPs with zeroes (1: allow for them)
      maxNCHROM: -99, //Maximum number of chromosomes to be analysed (-99 = all chromosomes; maximum number is 200)
      maxNSNP: 50000, //Maximum approx number of SNPs per chromosomes to be analysed (maximum number is 50000)
      hc:  0.05, //Maximum value of c analysed (recommended 0.05; maximum is 0.5)
      REPS: 40, //Number of replicates to run GONE (recommended 40)
      threads:  -99 //Number of threads (if -99 it uses all possible processors)
    ]

    Phlash = [
      Num_chr_test: 0 // the number of chromsome to be test data 
    ]

}


