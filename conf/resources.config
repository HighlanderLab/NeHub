// Resource profiles for the Ne-estimation pipeline
//
// Select a profile on the command line:
//   -profile small    testing or small datasets  (≤20 samples, ≤5 chromosomes)
//   -profile large    big datasets               (>100 samples, many chromosomes)
//   (no profile)      default resources defined inline in each module
//
// These profiles can be combined with docker or ci:
//   nextflow run main.nf -profile docker,small
//   nextflow run main.nf -profile docker,large

profiles {

    // ── GPU for Phlash ────────────────────────────────────────────────────────────────
    // if use gpu
    gpu {
        conda.enabled = true
        process {
            // Note: Set up GPU conda environment directly (not via .yml),
            // as installing dinopy via pip in a .yml-based env frequently fails
            // due to Cython build incompatibilities.
            // conda = "path of your phlash_gpu environment"
            withName: 'run_Phlash_process' {container = null; conda = "/exports/cmvm/eddie/eb/groups/HighlanderLab/share/PigData/anaconda/envs/phlash"}
        }
    }

    // ── small ────────────────────────────────────────────────────────────────
    // Cut memory and CPU roughly in half for fast iteration on small data or
    // testing.  MSMC is especially reduced because 160 GB is wasteful for
    // small input.
    small {
        process {

            // main.nf
            // withName: 'sampling2popfile' { }
            // withName: 'split_pop' { }
            // withName: 'indexVCF' { }
            // MSMC.nf
            // withName: 'sampling_convert' { }
            withName: 'run_MSMC_process'      { cpus = 2;  memory = '8 GB' }
            // withName: 'summarize_MSMC' { }
            // Relate.nf
            // withName: 'split_ancestral_chr' { }
            // withName: 'prepare_relate_chr' { }
            // withName: 'makeChunks' { }
            withName: 'paintChunks' {cpus = 1; memory = '4 GB'}
            // withName: 'getWindows' { }
            withName: 'buildTopology' {cpus = 1; memory = '4 GB'}
            withName: 'findEquivalentBranches'{ cpus = 1;  memory = '4 GB'  }
            withName: 'inferBranchLengths'{ cpus = 1;  memory = '4 GB'  }
            withName: 'combineArgs'           { cpus = 1;  memory = '4 GB'  }
            withName: 'finalizeRelate'  {  cpus = 1;  memory = '4 GB' }
            withName: 'RemoveTrees' { cpus = 1; memory = '4 GB' }
            withName: 'GenerateRate' { cpus = 1; memory = '4 GB' }
            withName: 'SampleBranchCallCoal'  { cpus = 2; memory = '32 GB' }
            // withName: 'DivideAncMut'    { }
            withName: 'SampleBranchLength'    { memory = '8 GB' }
            // withName: 'CombineAncMut' { }
            // withName: 'CoalRateForTree' { }
            // withName: 'CoalRatePairwise' { }
            // withName: 'SummarizeCoalRate' { }
            withName: 'DivideAncMutFinal' {cpus = 2;  memory = '16 GB' }
            // withName: 'ReEstimateBranchLengths' { }
            // withName: 'CombineAncMutFinal' { }
            // withName: 'summarize_Relate' { }
            // SMCPP.nf
            withName: 'index_and_label_smc' { cpus = 1; memory = '4 GB'}
            withName: 'vcf2smc_process'       { cpus = 1;  memory = '4 GB'  }
            withName: 'run_smcpp_process'     { cpus = 2;  memory = '16 GB'  }
            // withName: 'draw_smcpp_process' { }
            // withName: 'summarize_SMCpp' { }
            // tskit.nf
            withName: 'ts_infer'              { cpus = 2;  memory = '8 GB'  }
            withName: 'ts_date'               { cpus = 1;  memory = '4 GB'  }
            // withName: 'summarize_tsinfer'     { }
            // GONE.nf
            withName: 'convert2plink'         { cpus = 1;  memory = '4 GB'  }
            withName: 'run_LD'                { cpus = 1;  memory = '8 GB'  }
            withName: 'run_GONE_process'      { cpus = 1;  memory = '8 GB'  }
            // withName: 'summarize_GONE' { }
            // Phlash.nf
            //if use gpu
            // withName: 'run_Phlash_process' { accelerator = 1; clusterOptions = '-l gpu=1'}
            // withName: 'summarize_Phlash' { }
            // PSMC.nf
            // withName: 'convert2fq' { }
            // withName: 'mergeFastq' { }
            // withName: 'PSMC' { }
            // withName: 'summarize_PSMC' { }
            // stairway.nf
            // withName: 'polarize' { }
            // withName: 'filter_missing' { }
            // withName: 'group_by_population_vcf' { }
            // withName: 'generate_sfs' { }
            // withName: 'write_stairway_blueprints' { }
            // withName: 'run_stairway_process' { }
            // withName: 'summarize_stairway_results' { }

            
        }
    }

    // ── large ────────────────────────────────────────────────────────────────
    // Scale up for large cohorts.  Tune individual withName blocks further if
    // you know the exact bottleneck (MSMC and Relate are usually the heaviest).
    large {
        process {
            // main.nf
            // withName: 'sampling2popfile' { }
            withName: 'split_pop' {cpus = 2; memory = '16 GB' }
            // withName: 'indexVCF' { }
            // MSMC.nf
            // withName: 'sampling_convert' { }
            withName: 'run_MSMC_process'      { cpus = 10;  memory = '160 GB' }
            // withName: 'summarize_MSMC' { }
            // Relate.nf
            // withName: 'split_ancestral_chr' { }
            // withName: 'prepare_relate_chr' { }
            // withName: 'makeChunks' { }
            withName: 'paintChunks' {cpus = 1; memory = '16 GB'}
            // withName: 'getWindows' { }
            withName: 'buildTopology' {cpus = 1; memory = '16 GB'}
            withName: 'findEquivalentBranches'{ cpus = 1;  memory = '16 GB'  }
            withName: 'inferBranchLengths'{ cpus = 1;  memory = '8 GB'  }
            withName: 'combineArgs'           { cpus = 1;  memory = '16 GB'  }
            withName: 'finalizeRelate'  {  cpus = 1;  memory = '16 GB' }
            withName: 'RemoveTrees' { cpus = 1; memory = '4 GB' }
            withName: 'GenerateRate' { cpus = 1; memory = '4 GB' }
            withName: 'SampleBranchCallCoal'  { cpus = 8; memory = '64 GB'  }
            // withName: 'DivideAncMut'    { }
            withName: 'SampleBranchLength'    { memory = '32 GB' }
            // withName: 'CombineAncMut' { }
            // withName: 'CoalRateForTree' { }
            // withName: 'CoalRatePairwise' { }
            // withName: 'SummarizeCoalRate' { }
            // withName: 'DivideAncMutFinal' { }
            // withName: 'ReEstimateBranchLengths' { }
            // withName: 'CombineAncMutFinal' { }
            // withName: 'summarize_Relate' { }
            // SMCPP.nf
            withName: 'index_and_label_smc' { cpus = 1; memory = '4 GB'}
            withName: 'vcf2smc_process'       { cpus = 2;  memory = '8 GB'  }
            withName: 'run_smcpp_process'     { cpus = 8;  memory = '16 GB'; time = '24h' }
            // withName: 'draw_smcpp_process' { }
            // withName: 'summarize_SMCpp' { }
            // tskit.nf
            withName: 'ts_infer'              { cpus = 8;  memory = '16 GB'  }
            withName: 'ts_date'               { cpus = 4;  memory = '16 GB'  }
            // withName: 'summarize_tsinfer'     { }
            // GONE.nf
            withName: 'convert2plink'         { cpus = 4;  memory = '16 GB'  }
            withName: 'run_LD'                { cpus = 4;  memory = '16 GB'  }
            withName: 'run_GONE_process'      { cpus = 4;  memory = '16 GB'  }
            // withName: 'summarize_GONE' { }
            // Phlash.nf
            // withName: 'run_Phlash_process' { }
            // withName: 'summarize_Phlash' { }
            // PSMC.nf
            withName: 'convert2fq' { cpus = 2; maxForks = 6; memory = '4 GB'}
            withName: 'mergeFastq' { cpus = 2; maxForks = 6; memory = '4 GB' }
            withName: 'PSMC' { cpus = 4; maxForks = 6; memory = '8 GB' }
            withName: 'summarize_PSMC' { memory = '4 GB' }
            // stairway.nf
            // withName: 'polarize' { }
            // withName: 'filter_missing' { }
            withName: 'generate_sfs' {cpus = 2; maxForks = 6;  memory = '32 GB';errorStrategy = 'retry'; maxRetries = 3 }
            // withName: 'group_by_population_sfs' { }
            // withName: 'write_stairway_blueprints' { }
            withName: 'run_stairway_process' { cpus = 4;  memory = '64 GB'}
            // withName: 'summarize_stairway_results' { }
        }
    }
    
    // ── github ────────────────────────────────────────────────────────────────
    github_small {
        process {

            // main.nf
            // withName: 'sampling2popfile' { }
            // withName: 'split_pop' { }
            // withName: 'indexVCF' { }
            // MSMC.nf
            // withName: 'sampling_convert' { }
            withName: 'run_MSMC_process'      { cpus = 2;  memory = '6 GB' }
            // withName: 'summarize_MSMC' { }
            // Relate.nf
            // withName: 'split_ancestral_chr' { }
            // withName: 'prepare_relate_chr' { }
            // withName: 'makeChunks' { }
            withName: 'paintChunks' {cpus = 1; memory = '4 GB'}
            // withName: 'getWindows' { }
            withName: 'buildTopology' {cpus = 1; memory = '4 GB'}
            withName: 'findEquivalentBranches'{ cpus = 1;  memory = '4 GB'  }
            withName: 'inferBranchLengths'{ cpus = 1;  memory = '4 GB'  }
            withName: 'combineArgs'           { cpus = 1;  memory = '4 GB'  }
            withName: 'finalizeRelate'  {  cpus = 1;  memory = '4 GB' }
            withName: 'RemoveTrees' { cpus = 1; memory = '4 GB' }
            withName: 'GenerateRate' { cpus = 1; memory = '4 GB' }
            withName: 'SampleBranchCallCoal'  { cpus = 2; memory = '6 GB' }
            // withName: 'DivideAncMut'    { }
            withName: 'SampleBranchLength'    { memory = '6 GB' }
            // withName: 'CombineAncMut' { }
            // withName: 'CoalRateForTree' { }
            // withName: 'CoalRatePairwise' { }
            // withName: 'SummarizeCoalRate' { }
            withName: 'DivideAncMutFinal' {cpus = 2;  memory = '6 GB' }
            // withName: 'ReEstimateBranchLengths' { }
            // withName: 'CombineAncMutFinal' { }
            // withName: 'summarize_Relate' { }
            // SMCPP.nf
            withName: 'index_and_label_smc' { cpus = 1; memory = '4 GB'}
            withName: 'vcf2smc_process'       { cpus = 1;  memory = '4 GB'  }
            withName: 'run_smcpp_process'     { cpus = 2;  memory = '6 GB'  }
            // withName: 'draw_smcpp_process' { }
            // withName: 'summarize_SMCpp' { }
            // tskit.nf
            withName: 'ts_infer'              { cpus = 2;  memory = '6 GB'  }
            withName: 'ts_date'               { cpus = 1;  memory = '4 GB'  }
            // withName: 'summarize_tsinfer'     { }
            // GONE.nf
            withName: 'convert2plink'         { cpus = 1;  memory = '4 GB'  }
            withName: 'run_LD'                { cpus = 1;  memory = '6 GB'  }
            withName: 'run_GONE_process'      { cpus = 1;  memory = '6 GB'  }
            // withName: 'summarize_GONE' { }
            // Phlash.nf
            //if use gpu
            // withName: 'run_Phlash_process' { accelerator = 1; clusterOptions = '-l gpu=1'}
            // withName: 'summarize_Phlash' { }
            // PSMC.nf
            // withName: 'convert2fq' { }
            // withName: 'mergeFastq' { }
            // withName: 'PSMC' { }
            // withName: 'summarize_PSMC' { }
            // stairway.nf
            // withName: 'polarize' { }
            // withName: 'filter_missing' { }
            // withName: 'group_by_population_vcf' { }
            // withName: 'generate_sfs' { }
            // withName: 'write_stairway_blueprints' { }
            // withName: 'run_stairway_process' { }
            // withName: 'summarize_stairway_results' { }

            
        }
    }
}
